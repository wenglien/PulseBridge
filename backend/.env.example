# ── LLM ──────────────────────────────────────────────────────────────────────
# Get a free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# ── Storage ───────────────────────────────────────────────────────────────────
DATA_DIR=./data
MAX_CSV_FILE_SIZE_MB=100
# Upper bound for the (decompressed) Apple Health export.xml
MAX_XML_SIZE_MB=4096

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for local / staging environments
CORS_ORIGINS=http://localhost:3000

# Optional regex for dynamic origins (e.g. Firebase Hosting previews).
# Leave empty if not needed.
# Example: https://your-project\.(web\.app|firebaseapp\.com)$
CORS_ORIGIN_REGEX=

# ── Security ──────────────────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-generate-a-strong-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=43200   # 30 days

# ── Storage ───────────────────────────────────────────────────────────────────
# sql (default): SQLAlchemy, SQLite at DATA_DIR/pulsebridge.db — for local development
# firestore: Firestore + Cloud Storage — required on Cloud Run (see docs/deploy-cloud-run.md)
STORAGE_BACKEND=sql
GCP_PROJECT=
GCS_BUCKET=
FIRESTORE_PREFIX=

# ── Database (STORAGE_BACKEND=sql only) ───────────────────────────────────────
# Leave blank to use default SQLite at DATA_DIR/pulsebridge.db
# For PostgreSQL (sync driver; `pip install psycopg2-binary`):
#   postgresql+psycopg2://user:password@host:5432/dbname
DATABASE_URL=
